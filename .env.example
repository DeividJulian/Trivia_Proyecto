# Copia este archivo como .env y ajusta los valores. Nunca subas el .env al repositorio.

# Token del panel de administrador (header X-Admin-Token). Vacío = panel bloqueado.
ADMIN_TOKEN=

# Permite usar el modo Saboteador (true/false).
PERMITIR_SABOTAJE=true

# Número máximo de partidas simultáneas.
MAX_PARTIDAS=500

# Minutos de inactividad tras los que se elimina una partida.
PARTIDA_TTL_MINUTOS=30
